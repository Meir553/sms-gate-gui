{
  "name": "sms-gateway-v2",
  "version": "2.0.0",
  "description": "SMS Gateway v2 with TypeScript client and modern GUI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build-gui": "cd client-ts/gui && npm run build",
    "dev-full": "concurrently \"npm run dev\" \"cd client-ts/gui && npm run dev\"",
    "install-all": "npm install && cd client-ts/gui && npm install",
    "clean": "rm -rf dist client-ts/gui/dist node_modules client-ts/gui/node_modules",
    "reset-db": "rm -f webhooks.db",
    "setup": "npm run install-all && cp env.example .env"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "body-parser": "^1.20.2",
    "node-fetch": "^2.7.0",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "sms",
    "gateway",
    "typescript",
    "react",
    "gui",
    "webhook",
    "messaging",
    "api",
    "dashboard"
  ],
  "author": "Meir Gottlieb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/sms-gateway-v2.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/sms-gateway-v2/issues"
  },
  "homepage": "https://github.com/your-username/sms-gateway-v2#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
